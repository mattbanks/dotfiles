#!/bin/bash

# Master update script - updates all package managers
update-all() {
    echo "🚀 Updating all package managers..."
    echo ""

    # Update Homebrew
    echo "🍺 Updating Homebrew..."
    brew bump
    if [ $? -ne 0 ]; then
        echo "⚠️  Homebrew update failed"
    fi

    echo ""

    # Update znap
    echo "⚡ Updating znap..."
    znap pull
    if [ $? -ne 0 ]; then
        echo "⚠️  znap update failed"
    fi

    echo ""

    # Update mise-managed runtimes and global CLI tools
    if command -v mise &> /dev/null; then
        echo "🛠️  Updating mise tools..."
        (cd "$HOME" && mise upgrade)
        if [ $? -ne 0 ]; then
            echo "⚠️  mise update failed"
        fi
    else
        echo "⏭️  Skipping mise (not installed)"
    fi

    echo ""

    # Update Claude CLI
    if command -v claude &> /dev/null; then
        echo "🤖 Updating Claude CLI..."
        claude update
        if [ $? -ne 0 ]; then
            echo "⚠️  Claude CLI update failed"
        fi
    else
        echo "⏭️  Skipping Claude CLI (not installed)"
    fi

    echo ""
    echo "🎉 All updates complete!"
}

# Always execute the function when script is run
update-all "$@"
