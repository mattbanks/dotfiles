#!/bin/zsh
# Set PATH, MANPATH, etc., for Homebrew.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Load any Keychain-saved SSH keys into the agent
# This is to make sure all SSH keys get loaded since
# I'm using multiple for various Github accounts
/usr/bin/ssh-add --apple-load-keychain -A >/dev/null 2>&1
