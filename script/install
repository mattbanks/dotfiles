#!/bin/sh
#
# Run all dotfiles installers.
set -e

cd "$(dirname "$0")"/..
DOTFILES=$(pwd -P)
export DOTFILES

# Find topic installers from the checked-out working tree so local additions and
# deletions are reflected before the next commit.
find . -mindepth 2 -maxdepth 2 -type f -name install.sh -print | LC_ALL=C sort |
while read -r installer; do
	installer=${installer#./}
	echo "› ${installer}..."
	sh "$installer"
done
